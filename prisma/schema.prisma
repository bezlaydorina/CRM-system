// The Code CRM - data model
// NOTE: Enum-like fields are declared as String and validated in
// application code (see src/lib/enums.ts) rather than as native Prisma
// enums, so the allowed values can be changed without a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Core tenancy
// ---------------------------------------------------------------------------

model Organization {
  id             String          @id @default(cuid())
  name           String
  logoUrl        String? // ügynökség logó - lásd admin Beállítások
  primaryColor   String? // hex szín, felülírja a --color-brand-maroon CSS változót
  customDomain   String? // tájékoztató jellegű - a tényleges DNS/domain-kötés a Vercel projekt Domains beállításaiban történik
  createdAt      DateTime        @default(now())
  accounts               Account[]
  teamMembers            TeamMember[]
  tasks                  Task[]
  calendarEvents         CalendarEvent[]
  intakeFormFieldDefs    IntakeFormFieldDefinition[]
}

model TeamMember {
  id                      String       @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id])
  name                    String
  email                   String       @unique
  phone                   String?
  passwordHash            String? // null amíg az invite emailből be nem állítja a sajátját
  avatarColor             String       @default("#6366f1")
  jobRole                 String // Admin, CSM, Closer, Setter, Fejlesztő, Értékesítő
  systemRole              String       @default("STAFF") // ADMIN | STAFF
  googleCalendarConnected Boolean      @default(false)
  googleRefreshToken      String? // OAuth refresh token - csak szerveroldalon olvasva
  googleAccessToken       String?
  googleTokenExpiresAt    DateTime?
  createdAt               DateTime     @default(now())

  assignments      TeamAssignment[]
  tasksAssigned    Task[]             @relation("TaskAssignee")
  notes            Note[]
  activityEntries  ActivityLogEntry[]
  approvalsCreated ApprovalItem[]     @relation("ApprovalCreatedBy")
  calendarEvents   CalendarEvent[]
  messages         Message[]          @relation("StaffMessages")
  projectsAssigned Project[]
  authTokens       AuthToken[]
}

// ---------------------------------------------------------------------------
// Account (tenant / client company)
// ---------------------------------------------------------------------------

model Account {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name               String
  website            String?
  industry           String?
  status             String   @default("ACTIVE") // ACTIVE | ARCHIVED
  lifecycleStage     String   @default("CSM_CONTACT") // see enums.ts ACCOUNT_LIFECYCLE_STAGES
  lifecycleEnteredAt DateTime @default(now())

  monthlyFee       Float     @default(0)
  setupFee         Float     @default(0)
  startDate        DateTime?
  contractSignedAt DateTime?
  lastPaymentAt    DateTime?
  source           String?
  isTestAccount    Boolean   @default(false)
  isInternalSales  Boolean   @default(false) // true for the agency's own sales pipeline "account"

  nameFormat        String  @default("HU") // HU | EN
  callButtonEnabled Boolean @default(true)
  featureFlags      String  @default("{\"crm\":true,\"calendar\":true}") // JSON

  package String? // START | GROWTH | NEXT_LEVEL - az onboardingnál választott csomag

  portalPasswordHash String? // shared portal login fallback

  createdAt DateTime @default(now())

  contacts         Contact[]
  assignments      TeamAssignment[]
  pipelines        Pipeline[]
  tasks            Task[]
  approvalItems    ApprovalItem[]
  payments         Payment[]
  contracts        Contract[]
  reports          Report[]
  conversation     Conversation?
  fileAssets       FileAsset[]
  credentials      Credential[]
  activityEntries  ActivityLogEntry[]
  calendarEvents   CalendarEvent[]
  projects         Project[]
  referralsMade    Referral[] @relation("ReferralsMade")
  referralReceived Referral?  @relation("ReferralReceived")
  intakeFormResponses IntakeFormResponse[]
}

// ---------------------------------------------------------------------------
// Affiliate / ajánlói program
// ---------------------------------------------------------------------------

model Referral {
  id                String    @id @default(cuid())
  referrerAccountId String
  referrerAccount   Account   @relation("ReferralsMade", fields: [referrerAccountId], references: [id])
  referredAccountId String    @unique
  referredAccount   Account   @relation("ReferralReceived", fields: [referredAccountId], references: [id])
  status            String    @default("PENDING") // PENDING | REWARDED
  rewardedAt        DateTime?
  createdAt         DateTime  @default(now())
}

model Contact {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  fullName       String
  email          String?
  phone          String?
  position       String?
  isPrimary      Boolean  @default(false)
  canLoginPortal Boolean  @default(false)
  passwordHash   String?
  accessLevel    String   @default("FULL") // FULL | LIMITED
  createdAt      DateTime @default(now())

  calendarEvents CalendarEvent[]
  messages       Message[]       @relation("ClientMessages")
  authTokens     AuthToken[]
}

// ---------------------------------------------------------------------------
// Email-alapú jelszó-beállítás / meghívó linkek
// ---------------------------------------------------------------------------

model AuthToken {
  id           String      @id @default(cuid())
  token        String      @unique @default(cuid())
  purpose      String // PORTAL_SET_PASSWORD | STAFF_SET_PASSWORD
  contactId    String?
  contact      Contact?    @relation(fields: [contactId], references: [id])
  teamMemberId String?
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id])
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime    @default(now())
}

model TeamAssignment {
  id           String     @id @default(cuid())
  accountId    String
  account      Account    @relation(fields: [accountId], references: [id])
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id])
  role         String // Closer, Setter, CSM, Fejlesztő, Admin

  @@unique([accountId, teamMemberId, role])
}

// ---------------------------------------------------------------------------
// Mini-CRM (per account)
// ---------------------------------------------------------------------------

model Pipeline {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  stages          Stage[]
  webhooks        Webhook[]
  customFieldDefs CustomFieldDefinition[]
}

model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  name       String
  color      String   @default("#6366f1")
  order      Int      @default(0)

  opportunities Opportunity[]
  webhooks      Webhook[]
}

model Opportunity {
  id        String @id @default(cuid())
  stageId   String
  stage     Stage  @relation(fields: [stageId], references: [id])
  accountId String

  firstName       String
  lastName        String?
  email           String?
  phone           String?
  company         String?
  opportunityName String
  status          String   @default("OPEN") // OPEN | WON | LOST
  value           Float    @default(0)
  source          String?
  customFields    String   @default("{}") // JSON blob keyed by CustomFieldDefinition.id
  tags            String   @default("[]") // JSON array of strings
  assigneeId      String?
  createdAt       DateTime @default(now())

  notes           Note[]
  taskReminders   TaskReminder[]
  activityEntries ActivityLogEntry[]
  payments        Payment[]
}

model Note {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  authorId      String?
  author        TeamMember? @relation(fields: [authorId], references: [id])
  body          String
  createdAt     DateTime    @default(now())
}

model TaskReminder {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  title         String
  dueAt         DateTime
  assigneeId    String?
  done          Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model ActivityLogEntry {
  id            String       @id @default(cuid())
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  actorId       String?
  actor         TeamMember?  @relation(fields: [actorId], references: [id])
  type          String // MOVED_STAGE | CREATED | UPDATED | WEBHOOK_IN | CALL_LOGGED | NOTE_ADDED
  message       String
  createdAt     DateTime     @default(now())
}

model CustomFieldDefinition {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  name       String
  type       String // TEXT|LONG_TEXT|NUMBER|DATE|SELECT|MULTISELECT|EMAIL|PHONE|URL|CHECKBOX
  section    String   @default("Általános")
  options    String   @default("[]") // JSON array, for SELECT/MULTISELECT
  order      Int      @default(0)
}

// ---------------------------------------------------------------------------
// Értékesítési felvétel / Onboarding kérdőív - szervezet-szintű kérdés-séma,
// account-szintű válaszokkal (ugyanaz a JSON-alapú mező-motor, mint a
// mini-CRM egyéni mezőinél, csak nem Pipeline-hoz, hanem Organization-höz
// kötve, mert ez a két kérdőív minden ügyfélnél ugyanaz).
// ---------------------------------------------------------------------------

model IntakeFormFieldDefinition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  formKey        String // SALES_INTAKE | ONBOARDING
  name           String
  type           String // TEXT|LONG_TEXT|NUMBER|DATE|SELECT|MULTISELECT|EMAIL|PHONE|URL|CHECKBOX
  section        String       @default("Általános")
  options        String       @default("[]") // JSON array, for SELECT/MULTISELECT
  order          Int          @default(0)
}

model IntakeFormResponse {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  formKey   String // SALES_INTAKE | ONBOARDING
  answers   String   @default("{}") // JSON blob kulcsolva IntakeFormFieldDefinition.id szerint
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([accountId, formKey])
}

model Webhook {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id])
  accountId  String
  name       String
  token      String   @unique @default(cuid())
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Task management
// ---------------------------------------------------------------------------

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id])

  title         String
  description   String?
  category      String      @default("Egyéb") // Sikertelen fizetés, Felhívni, Kreatív, Szövegírás, Landing, Összeállítás...
  priority      String      @default("MEDIUM") // LOW|MEDIUM|HIGH|URGENT
  dueAt         DateTime?
  assigneeId    String?
  assignee      TeamMember? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  statusColumn  String      @default("ASSIGNED") // ASSIGNED|WAITING|DAY_ONE|DAY_TWO|DAY_THREE|BLOCKED
  autoGenerated Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Projects (Weboldalak / Webshopok / Applikációk / Automatizációk / Egyedi
// rendszerek) - fejlesztési projekt-nyilvántartás, kategóriánkénti Kanban
// nézettel az admin oldalon.
// ---------------------------------------------------------------------------

model Project {
  id          String      @id @default(cuid())
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id])
  title       String
  category    String // WEBOLDAL|WEBSHOP|APPLIKACIO|AUTOMATIZACIO|EGYEDI_RENDSZER
  status      String      @default("IGENYFELMERES") // see enums.ts PROJECT_STATUSES
  description String?
  budget      Float       @default(0)
  deadline    DateTime?
  assigneeId  String?
  assignee    TeamMember? @relation(fields: [assigneeId], references: [id])
  createdAt   DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Approvals
// ---------------------------------------------------------------------------

model ApprovalItem {
  id          String      @id @default(cuid())
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id])
  type        String // CREATIVE|LANDING|COPY|IMAGE
  title       String
  status      String      @default("PENDING_INTERNAL") // DRAFT|PENDING_INTERNAL|PENDING_CLIENT|APPROVED|REJECTED
  fileUrl     String?
  clientNote  String?
  createdById String?
  createdBy   TeamMember? @relation("ApprovalCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  decidedAt   DateTime?
}

// ---------------------------------------------------------------------------
// Payments, contracts, reports
// ---------------------------------------------------------------------------

model Payment {
  id               String       @id @default(cuid())
  accountId        String
  account          Account      @relation(fields: [accountId], references: [id])
  opportunityId    String?
  opportunity      Opportunity? @relation(fields: [opportunityId], references: [id])
  amount           Float
  type             String       @default("ONE_TIME") // ONE_TIME|MONTHLY|DEPOSIT
  status           String       @default("CREATED") // CREATED|SENT|PAID|EXPIRED|PENDING
  dueDate          DateTime?
  paymentLink      String? // legutóbb generált Barion GatewayUrl
  barionPaymentId  String? // Barion PaymentId - a callback és az állapot-lekérdezés ezen keresztül azonosít
  depositRemaining Float?
  createdAt        DateTime     @default(now())
}

model Contract {
  id                   String    @id @default(cuid())
  accountId            String
  account              Account   @relation(fields: [accountId], references: [id])
  status               String    @default("DRAFT") // DRAFT|SENT|VIEWED|SIGNED|DECLINED
  amount               Float
  templateName         String    @default("Alap szolgáltatási szerződés")
  documentUrl          String? // a generált (majd aláírás után a véglegesen aláírt) PDF elérési útja
  dropboxSignRequestId String? // Dropbox Sign signature_request_id - ha be van állítva, az állapotot a webhook vezérli
  createdAt            DateTime  @default(now())
  signedAt             DateTime?
}

model Report {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id])
  period      String    @default("WEEK") // WEEK|MONTH
  generatedAt DateTime  @default(now())
  isAutomatic Boolean   @default(true)
  metrics     String    @default("{}") // JSON: activeProjects, completedProjects, totalBudget, nextDeadline
  shareToken  String    @unique @default(cuid())
  emailSentAt DateTime?
}

// ---------------------------------------------------------------------------
// Communication
// ---------------------------------------------------------------------------

model Conversation {
  id        String    @id @default(cuid())
  accountId String    @unique
  account   Account   @relation(fields: [accountId], references: [id])
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  senderType      String // STAFF | CLIENT
  staffId         String?
  staff           TeamMember?  @relation("StaffMessages", fields: [staffId], references: [id])
  clientContactId String?
  clientContact   Contact?     @relation("ClientMessages", fields: [clientContactId], references: [id])
  body            String
  attachmentUrl   String?
  createdAt       DateTime     @default(now())
}

model FileAsset {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  folder     String   @default("IMAGES") // IMAGES|VIDEOS|OTHER
  fileName   String
  fileUrl    String
  fileType   String   @default("image")
  uploadedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Calendar
// ---------------------------------------------------------------------------

model CalendarEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id])
  teamMemberId   String?
  teamMember     TeamMember?  @relation(fields: [teamMemberId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  type           String       @default("CONVERSATION") // STRATEGY_CALL|ONBOARDING|CONVERSATION
  title          String
  startAt        DateTime
  endAt          DateTime
  meetLink       String?
  googleEventId  String? // a Google Calendar eseményének azonosítója, ha szinkronizálva lett
  createdAt      DateTime     @default(now())
}

model Credential {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  label          String
  value          String
  isConfidential Boolean  @default(true)
  createdAt      DateTime @default(now())
}
