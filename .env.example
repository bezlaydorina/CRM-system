# Local dev: a local Postgres instance.
# Production (Vercel): Supabase's pooled + direct connection strings.
DATABASE_URL="postgresql://postgres:password@localhost:5432/crm_dev"
DIRECT_URL="postgresql://postgres:password@localhost:5432/crm_dev"
SESSION_SECRET="change-me-to-a-long-random-string"

# Email küldéshez (meghívók, jelszó-beállító linkek, riport-email) - lásd README "Email küldés" szekció.
# RESEND_API_KEY nélkül minden email csak a konzolra íródik ki, nem küld semmit.
RESEND_API_KEY=""
EMAIL_FROM="The Code <onboarding@resend.dev>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bankkártyás fizetéshez (Barion) - lásd README "Fizetés (Barion)" szekció.
# BARION_POS_KEY nélkül a "Fizetés" gomb egy hibaüzenettel tér vissza, minden más működik.
BARION_POS_KEY=""
BARION_PAYEE_EMAIL=""
BARION_ENV="test"

# Google Calendar szinkronhoz - lásd README "Google Calendar szinkron" szekció.
# GOOGLE_CLIENT_ID/SECRET nélkül a "Csatlakoztatás" gomb egy hibaüzenettel tér vissza, minden más működik.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The Code asszisztenshez (ügyfélportál "The Code asszisztens" oldal) - lásd README "The Code asszisztens" szekció.
# ANTHROPIC_API_KEY nélkül az asszisztens egy egyszerű, szabályalapú válaszadóra esik vissza.
ANTHROPIC_API_KEY=""

# Szerződések e-aláírásához (Dropbox Sign) - lásd README "Szerződések e-aláírása" szekció.
# DROPBOX_SIGN_API_KEY nélkül a "Küldés e-aláírásra" gomb egy hibaüzenettel tér vissza, a kézi állapotkövetés változatlanul működik.
DROPBOX_SIGN_API_KEY=""
DROPBOX_SIGN_TEST_MODE="true"
